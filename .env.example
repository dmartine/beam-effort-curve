# Reflection platform API (OpenAI-compatible); used for the benchmark
REFLECTION_API_KEY=
REFLECTION_BASE_URL=https://api.reflection.ai/openai/v1
REFLECTION_MODEL=Beam-1.0-501B-A23B

# Ollama Cloud (optional): used for the preserve_thinking ablation
OLLAMA_API_KEY=

# Hugging Face (optional): HF Inference Providers route and publishing
HF_TOKEN=
HF_MODEL_ID=reflection/Beam-1.0-501B-A23B:baseten
HF_USERNAME=

# Default backend for src.run: reflection | ollama | hf
BACKEND=reflection

# Completion token cap
MAX_TOKENS=32768
